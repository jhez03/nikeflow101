# Caddy — TLS termination, static asset serving, FastCGI proxy to PHP-FPM.
# Replaces the old caddy+nginx pair. One container does everything.
#
# Replace staging.example.com and admin@example.com before deploying.
# Ports 80 and 443 must be open on the VPS firewall.

{
    email jlibay1053538@gmail.com
}

# Health check endpoint for Docker Swarm.
# wget inside the container sends Host: localhost, which does not match the
# named site block below. This bare :80 block catches those requests so the
# health check receives 200 instead of 404. It does NOT interfere with
# ACME HTTP-01 — Caddy handles /.well-known/acme-challenge/ automatically
# across all site blocks regardless of Host header.
:80 {
    handle /health {
        respond "ok" 200
    }
}

staging.thelaravelers.com {
    basicauth * {
        admin surigaolaravelers03#
    }
    # Security headers
    header X-Frame-Options "SAMEORIGIN"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Serve compiled Vite assets with immutable cache headers.
    # Vite produces content-hashed filenames so this is safe.
    @assets path /build/*
    handle @assets {
        root * /var/www/public
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Everything else: try static files first, then FastCGI to PHP-FPM.
    # php_fastcgi handles SCRIPT_FILENAME, PATH_INFO, and index.php fallback automatically.
    handle {
        root * /var/www/public
        php_fastcgi php:9000
        file_server
    }



    # Health check endpoint — handled directly by Caddy, no FastCGI round-trip.
    # Used by the Docker Swarm health check (wget http://localhost/health).
    handle /health {
        respond "ok" 200
    }

    # Block dot-files (e.g. .env, .git) except ACME well-known challenge path
    @hidden {
        path /.*
        not path /.well-known*
    }
    respond @hidden 403
}

